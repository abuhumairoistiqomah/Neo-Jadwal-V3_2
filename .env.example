# E-Jadwal V3.5 — local environment example
# Copy this file to .env.local and fill ONLY browser-safe values.

# Supabase project URL from the Project Connect dialog.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Browser-safe publishable key (starts with sb_publishable_...).
# NEVER place a secret key/service-role key in VITE_* variables.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Existing AI Studio values are kept for compatibility with the legacy project.
GEMINI_API_KEY=replace-with-your-gemini-api-key
APP_URL="MY_APP_URL"
